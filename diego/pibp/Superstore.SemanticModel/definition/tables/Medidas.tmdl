	measure 'Tendencia Perdida' =
			
			VAR sel = [Año Referencia]
			VAR y = SELECTEDVALUE ( 'Años Eje'[Año Eje] )
			RETURN IF ( y = sel || y = sel - 1, CALCULATE ( [% Pedidos con Pérdida], REMOVEFILTERS ( Calendario ), Calendario[Año] = y ) )
