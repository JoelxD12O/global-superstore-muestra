	measure 'Subtitulo Grafica 3' =
			
			VAR _anio = [Año Referencia]
			VAR _anioAnt = _anio - 1
			RETURN
			    "Ventas " & _anioAnt & " vs " & _anio & "  ·  ● días de envío promedio " & _anio
		displayFolder: Gráfica 3
		lineageTag: fa55f6f3-1350-44b2-b88a-70232d7a8df4

	/// Costo de envío respecto a la venta (P12)
	measure 'Costo Envio %' = DIVIDE ( SUM ( Base[Shipping.Cost] ), [Ventas Totales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Gráfica 3
		lineageTag: 8415661c-bbf7-4144-8e7a-1705924f0cc3

	/// Margen promedio de todo lo filtrado (referencia para colores)
	measure 'Margen Promedio Pagina' = CALCULATE ( [Margen Porcentual], ALLSELECTED () )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Gráfica 4
		lineageTag: dca8462a-c8d4-41a2-9106-50dce82fd844

	/// Rojo si pierde, naranja si está bajo el promedio, verde si está sobre el promedio
	measure 'Color Margen' =
			
			VAR m = [Margen Porcentual]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( m ), BLANK (),
			        m < 0, "#C0392B",
			        m < [Margen Promedio Pagina], "#E8871E",
			        "#3C8D5A"
			    )
		displayFolder: Gráfica 4
		lineageTag: 3ba319c5-7c4f-46ae-8735-ec766a8058c8

	measure 'Color Ganancia' = IF ( [Ganancia Total] < 0, "#C0392B", "#3A6EA5" )
		displayFolder: Formato Condicional
		lineageTag: 4e4d2b16-8d12-4d16-a575-6729cd65b335

	/// Gráfica P15: columna para 'Sin descuento' (altura 0)
	measure 'Con ganancia' = IF ( [Descuento Promedio] = 0, 0 )
		formatString: 0%
		displayFolder: Gráfica 5
		lineageTag: 28ce2303-eb3c-41ae-a45a-f602244504a2

	/// Gráfica P15 (columna roja): descuento promedio cedido, dibujado bajo el suelo
	measure 'Con pérdida' = VAR d = [Descuento Promedio] RETURN IF ( d > 0, -d )
		formatString: +0%;-0%;0%
		displayFolder: Gráfica 5
		lineageTag: ec4b78b3-85ae-4ab7-bc0c-0c3a6d993989

	measure 'Línea Cero' = IF ( NOT ISBLANK ( [Ventas Totales] ), 0 )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Gráfica 5
		lineageTag: b8c52dce-e961-4ba8-b408-28bb675a7d4e

	/// Máximo de ambos ejes de la gráfica de descuentos: simétrico, 20% sobre el mayor valor entre descuento y variación de venta
	measure 'G5 Eje Ganancia Max' =
			
			1.2 * MAXX (
			    ALLSELECTED ( Base[Rango Descuento] ),
			    MAX ( [Descuento Promedio], ABS ( [Var Venta vs Sin Descuento] ) )
			)
		displayFolder: Gráfica 5
		lineageTag: 0ff2b95e-cef8-4761-a125-ef49a27e4b4e

	measure 'G5 Eje Ganancia Min' = - [G5 Eje Ganancia Max]
		displayFolder: Gráfica 5
		lineageTag: a9cd00cb-457a-4a2d-bc41-5889696d5f66

	/// Igual a G5 Eje Ganancia Max, para que línea y columnas compartan escala
	measure 'G5 Eje Margen Max' = [G5 Eje Ganancia Max]
		displayFolder: Gráfica 5
		lineageTag: 4b99dcc8-c903-4343-a2aa-67d025d09186

	measure 'G5 Eje Margen Min' = - [G5 Eje Margen Max]
		displayFolder: Gráfica 5
		lineageTag: fefbcd0d-ad72-4d45-b561-f7d3300578dd

	/// Gráfica P15: etiqueta del descuento para 'Sin descuento'
	measure 'Etiqueta Ganancia' = IF ( [Descuento Promedio] = 0, 0 )
		displayFolder: Gráfica 5
		lineageTag: 240ae6a6-9a01-4300-9971-11ae4a50f41e

		formatStringDefinition = """0%"""

	/// Gráfica P15: etiqueta del descuento cedido, sobre la línea del cero
	measure 'Etiqueta Pérdida' = IF ( [Descuento Promedio] > 0, 0 )
		displayFolder: Gráfica 5
		lineageTag: 5e91052e-1000-4ee1-8d43-fbbd8c08eda2

		formatStringDefinition = """" & FORMAT ( - [Descuento Promedio], "+0%;-0%;0%" ) & """"

	/// P5: pedidos cuya ganancia total (suma de sus líneas) es negativa / total de pedidos
	measure '% Pedidos con Pérdida' =
			
			VAR _pedidos =
			    ADDCOLUMNS ( VALUES ( Base[Order.ID] ), "@Ganancia", CALCULATE ( SUM ( Base[Profit] ) ) )
			RETURN
			    DIVIDE ( COUNTROWS ( FILTER ( _pedidos, [@Ganancia] < 0 ) ), COUNTROWS ( _pedidos ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI'S
		lineageTag: e8e10f0c-738d-4434-b581-8dad484c8339

	/// Venta promedio de cada producto vendido (línea de pedido)
	measure 'Venta Promedio por Línea' = DIVIDE ( [Ventas Totales], COUNTROWS ( Base ) )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Gráfica 5
		lineageTag: 130be5e1-c94d-4793-9446-426290128aad

	/// Unidades promedio por producto vendido
	measure 'Unidades Promedio por Línea' = DIVIDE ( SUM ( Base[Quantity] ), COUNTROWS ( Base ) )
		formatString: 0.00
		displayFolder: Gráfica 5
		lineageTag: c8175ce0-68d1-47fa-a3fb-6db1b6bfb314

	/// P15: cuánto más (o menos) se vende por producto en cada nivel de descuento, comparado con vender sin descuento
	measure 'Var Venta vs Sin Descuento' =
			
			VAR _base =
			    CALCULATE ( [Venta Promedio por Línea], REMOVEFILTERS ( Base[Rango Descuento] ), Base[Orden Descuento] = 1 )
			RETURN
			    IF ( NOT ISBLANK ( [Venta Promedio por Línea] ), DIVIDE ( [Venta Promedio por Línea] - _base, _base ) )
		formatString: +0%;-0%;0%
		displayFolder: Gráfica 5
		lineageTag: 8ec2d112-ca32-4e90-90fc-5619627d4352

	/// P15: cuántas más (o menos) unidades se compran por producto en cada nivel de descuento, comparado con sin descuento
	measure 'Var Unidades vs Sin Descuento' =
			
			VAR _base =
			    CALCULATE ( [Unidades Promedio por Línea], REMOVEFILTERS ( Base[Rango Descuento] ), Base[Orden Descuento] = 1 )
			RETURN
			    IF ( NOT ISBLANK ( [Unidades Promedio por Línea] ), DIVIDE ( [Unidades Promedio por Línea] - _base, _base ) )
		formatString: +0%;-0%;0%
		displayFolder: Gráfica 5
		lineageTag: 707d2e53-23c1-414f-bc1a-a8d8c23ceb60

	/// P15: descuento promedio aplicado a los productos vendidos
	measure 'Descuento Promedio' = AVERAGE ( Base[Discount] )
		formatString: 0%
		displayFolder: Gráfica 5
		lineageTag: 3ff7a499-5569-4ae7-b949-92f7a2d95b1c

	/// P16: tamaño de la burbuja = ganancia en valor absoluto (Power BI no dibuja bien tamaños negativos, y las combinaciones críticas tienen ganancia negativa)
	measure 'Tamaño Burbuja' = ABS ( [Ganancia Total] )
		formatString: \$#,0
		displayFolder: Gráfica 9
		lineageTag: 446ccc5a-eb25-451f-a888-c4903085c6e7

	/// P16: texto con el número de combinaciones críticas visibles
	measure 'Subtítulo Gráfica 9' =
			
			VAR _n =
			    CALCULATE (
			        COUNTROWS ( Combinaciones ),
			        Combinaciones[Estado] = "Combinación que pierde (ventas ≥ $5K)"
			    )
			RETURN
			    _n & " combinaciones pierden dinero con al menos $5K en ventas"
		displayFolder: Gráfica 9
		lineageTag: 2a8410ec-2303-43bf-b9b2-b4ac029b2e97

	/// P14: diferencia entre el margen de la celda y el margen promedio de todo lo filtrado
	measure 'Brecha vs Promedio' = IF ( NOT ISBLANK ( [Margen Porcentual] ), [Margen Porcentual] - [Margen Promedio Pagina] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Gráfica 10
		lineageTag: 065b8613-5801-4371-82a8-319b3256c6ab

	/// P14: margen con ícono. ✓ sobre el promedio · ~ hasta 3 puntos debajo · ✗ más de 3 puntos debajo
	measure 'Margen vs Promedio' = [Margen Porcentual]
		displayFolder: Gráfica 10
		lineageTag: be6c11a3-394d-4eda-a471-e89566efe61f

		formatStringDefinition =
				
				VAR b = [Brecha vs Promedio]
				VAR icono =
				    SWITCH ( TRUE (), ISBLANK ( b ), "", b >= 0, "✓ ", b >= -0.03, "~ ", "✗ " )
				RETURN
				    """" & icono & """0.0%;""" & icono & """-0.0%;""" & icono & """0.0%"

	/// P14: color de fondo de la celda (verde / amarillo / rojo)
	measure 'Color Fondo Margen' =
			
			VAR b = [Brecha vs Promedio]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( b ), BLANK (), b >= 0, "#DFF0E3", b >= -0.03, "#FFF0C9", "#F9DEDC" )
		displayFolder: Gráfica 10
		lineageTag: 302747cc-fa7a-4f58-a219-d307b7ecf271

	/// P14: color del texto de la celda (verde / ámbar / rojo)
	measure 'Color Texto Margen' =
			
			VAR b = [Brecha vs Promedio]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( b ), BLANK (), b >= 0, "#2E7D4F", b >= -0.03, "#9A6B00", "#B03A2E" )
		displayFolder: Gráfica 10
		lineageTag: 84dfdae9-0117-452a-b4d2-a4461f64db3c

	/// Mini gráfica KPI: Ventas Totales del año de referencia (por mes)
	measure 'KPI Ventas Actual' =
			VAR a = [Año Referencia]
			RETURN CALCULATE ( [Ventas Totales], Calendario[Año] = a )
