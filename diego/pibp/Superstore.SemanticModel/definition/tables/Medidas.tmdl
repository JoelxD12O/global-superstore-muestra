	measure 'Margen Promedio Filtro' =
			
			IF (
			    NOT ISBLANK ( [Ventas Totales] ),
			    CALCULATE ( [Margen Porcentual], ALLSELECTED ( Calendario ) )
			)
		formatString: 0.0%;-0.0%;0.0%
