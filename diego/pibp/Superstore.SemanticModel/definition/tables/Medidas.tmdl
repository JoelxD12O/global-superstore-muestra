	measure 'Ventas Año Actual' =
			
			VAR _anio = [Año Referencia]
			RETURN
			    CALCULATE ( [Ventas Totales], REMOVEFILTERS ( Calendario ), Calendario[Año] = _anio )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Comparación Anual
