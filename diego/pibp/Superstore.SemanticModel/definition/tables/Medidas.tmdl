	measure 'Tendencia Ventas' =
			
			VAR sel = [Año Referencia]
			VAR y = SELECTEDVALUE ( 'Años Eje'[Año Eje] )
			RETURN IF ( y = sel || y = sel - 1, CALCULATE ( [Ventas Totales], REMOVEFILTERS ( Calendario ), Calendario[Año] = y ) )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Tendencia
		lineageTag: a5594a83-926d-4a95-88b2-ca2c21e5d3d1

	measure 'Tendencia Ganancia' =
			
			VAR sel = [Año Referencia]
			VAR y = SELECTEDVALUE ( 'Años Eje'[Año Eje] )
			RETURN IF ( y = sel || y = sel - 1, CALCULATE ( [Ganancia Total], REMOVEFILTERS ( Calendario ), Calendario[Año] = y ) )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Tendencia
		lineageTag: 964c314c-779f-4688-a37c-2e66074d7d03

