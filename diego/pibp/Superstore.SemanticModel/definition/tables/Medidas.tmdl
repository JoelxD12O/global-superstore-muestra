	/// Mini gráfica KPI: Ventas Totales del año anterior (por mes)
	measure 'KPI Ventas Anterior' =
			VAR a = [Año Referencia]
			RETURN CALCULATE ( [Ventas Totales], Calendario[Año] = a - 1 )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: KPI Tarjetas
