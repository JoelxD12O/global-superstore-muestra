			RETURN IF ( y = sel || y = sel - 1, CALCULATE ( [Margen Porcentual], REMOVEFILTERS ( Calendario ), Calendario[Año] = y ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Tendencia
