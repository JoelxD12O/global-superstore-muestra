	/// Texto de la píldora de variación vs año anterior
	measure 'KPI Ventas Var Texto' =
			VAR v = [Var Ventas]
			RETURN IF ( ISBLANK ( v ), "sin año previo", FORMAT ( v, "+0.0%;-0.0%;0.0%" ) )
		displayFolder: KPI Tarjetas
