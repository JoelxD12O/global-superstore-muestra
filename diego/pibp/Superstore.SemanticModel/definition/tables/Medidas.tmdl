	measure 'Ventas Año Anterior' =
			
			VAR _anio = [Año Referencia]
			VAR _anioAnt = _anio - 1
			RETURN
			    CALCULATE ( [Ventas Totales], REMOVEFILTERS ( Calendario ), Calendario[Año] = _anioAnt )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Comparación Anual
		lineageTag: 7df5d0d0-ac98-4d13-a6b9-a8896d864926

	measure 'Crecimiento Ventas %' =
			
			VAR _act = [Ventas Año Actual]
			VAR _ant = [Ventas Año Anterior]
			RETURN
			    IF ( NOT ISBLANK ( _ant ), DIVIDE ( _act - _ant, _ant ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Comparación Anual
		lineageTag: 9ab4aa55-ee81-4a72-b1bc-243b25a101cb

