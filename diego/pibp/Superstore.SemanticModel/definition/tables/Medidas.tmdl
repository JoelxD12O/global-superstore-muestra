	/// Fondo de la píldora: verde si mejora, rojo si empeora
	measure 'KPI Ventas Var Fondo' =
			VAR v = [Var Ventas]
			RETURN SWITCH ( TRUE (), ISBLANK ( v ), "#EDEDED", v > 0, "#A9EBC3", v < 0, "#F2B8B8", "#EDEDED" )
		displayFolder: KPI Tarjetas
		lineageTag: de8167b6-097b-4f41-adf1-67c1adf66192

	/// Texto de la píldora: verde si mejora, rojo si empeora
	measure 'KPI Ventas Var Color' =
			VAR v = [Var Ventas]
			RETURN SWITCH ( TRUE (), ISBLANK ( v ), "#8A8A8A", v > 0, "#2FA35B", v < 0, "#D9454A", "#8A8A8A" )
		displayFolder: KPI Tarjetas
		lineageTag: e3e301f4-eb17-4322-b0a4-4d1e20bd068c

