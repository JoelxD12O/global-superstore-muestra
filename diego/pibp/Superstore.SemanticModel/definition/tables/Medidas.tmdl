	measure 'Var Perdida' =
			
			VAR a = [Año Referencia]
			VAR act = CALCULATE ( [% Pedidos con Pérdida], Calendario[Año] = a )
			VAR ant = CALCULATE ( [% Pedidos con Pérdida], Calendario[Año] = a - 1 )
			RETURN IF ( NOT ISBLANK ( act ) && NOT ISBLANK ( ant ), ( act - ant ) * 100 )
