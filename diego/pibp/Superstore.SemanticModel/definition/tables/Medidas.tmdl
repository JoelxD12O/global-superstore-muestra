	/// 1 si la combinación pertenece a la subcategoría elegida: la que se clickea en 'Ventas por subcategoría', o Bookcases por defecto
	measure 'Subcat Visible' =
			
			VAR _hayFiltro =
			    ISFILTERED ( DimProducto[Sub.Category] ) || ISFILTERED ( DimProducto[Category] )
			VAR _sub = SELECTEDVALUE ( Combinaciones[Subcategoría] )
			RETURN
			    IF ( _hayFiltro || _sub = "Bookcases", 1 )
		formatString: 0
		displayFolder: Gráfica 9
		lineageTag: 73f2dabe-d457-47e5-93ac-62842901b47d

	/// Ventas Totales solo para la subcategoría elegida (Bookcases por defecto)
	measure 'Ventas Subcat Elegida' = IF ( [Subcat Visible] = 1, [Ventas Totales] )
		formatString: \$#,0
		displayFolder: Gráfica 9
		lineageTag: e0bb94ff-a26a-4019-a087-260d1ae330c2

	/// Margen % solo para la subcategoría elegida (Bookcases por defecto)
	measure 'Margen Subcat Elegida' = IF ( [Subcat Visible] = 1 && NOT ISBLANK ( [Ventas Totales] ), [Margen Porcentual] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Gráfica 9
		lineageTag: 496ccbff-f9a8-44a7-82d2-e158736a3cfa

	measure 'Tamaño Burbuja Subcat' = IF ( [Subcat Visible] = 1, [Tamaño Burbuja] )
		formatString: \$#,0
		displayFolder: Gráfica 9
		lineageTag: e90aa92b-d839-40bb-92b4-ba7681ef9eee

	/// Fondo del mapa de calor Subcategoría × Mercado según el margen
	measure 'Color Mapa Calor' =
			
			VAR m = [Margen Porcentual]
			VAR p = [Margen Promedio Pagina]
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( m ), BLANK (),
			        m < -0.10, "#E06666",
			        m < 0, "#F4B6B0",
			        m < p, "#FBE3C4",
			        m < 2 * p, "#B7DFC4",
			        "#6DBE8A"
			    )
		displayFolder: Gráfica 9
		lineageTag: f70c9491-2e51-4a00-b0e2-11e937688981

	/// Cascada: primer paso = ventas del año anterior (vacío en 2011), luego el cambio de ventas de cada mercado. El total final = ventas del año elegido.
	measure 'Cascada Ventas' =
			
			VAR _paso = SELECTEDVALUE ( 'Cascada Mercado'[Paso] )
			VAR _orden = SELECTEDVALUE ( 'Cascada Mercado'[Orden] )
			RETURN
			    IF (
			        _orden = 0,
			        VAR _ant = [Ventas Año Anterior]
			        RETURN IF ( _ant <> 0, _ant ),
			        CALCULATE (
			            [Ventas Año Actual] - [Ventas Año Anterior],
			            TREATAS ( { _paso }, DimUbicacion[Market] )
			        )
			    )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: Dashboard pt2
		lineageTag: 5c876090-e62f-4799-8ad7-bd17e3b11777

	/// Fondo de la columna Margen en la tabla de modo de envío
	measure 'Color Margen Envio' =
			
			VAR m = [Margen Porcentual]
			VAR p = [Margen Promedio Pagina]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( m ), BLANK (), m < 0.75 * p, "#F4B6B0", m < p, "#FBE3C4", "#B7DFC4" )
		displayFolder: Dashboard pt2
		lineageTag: 6547f5b0-c3fd-418a-870c-dbcd5ec6f181

	/// Fondo de la columna Costo envío en la tabla de modo de envío
	measure 'Color Costo Envio' =
			
			VAR c = [Costo Envio %]
			RETURN
			    SWITCH ( TRUE (), ISBLANK ( c ), BLANK (), c > 0.15, "#F4B6B0", c > 0.11, "#FBE3C4", "#B7DFC4" )
		displayFolder: Dashboard pt2
		lineageTag: 022c176a-d202-4a28-9c9f-8d74a14d8bc2

	/// Donut de segmentos: el valor es la participación en ventas (define el tamaño de cada porción) y el formato dinámico muestra solo el margen: 'margen 10.4%'. En el total (centro) muestra las ventas en $.
	measure 'Ventas Donut Segmento' =
			
			IF (
			    ISINSCOPE ( DimCliente[Segment] ),
			    DIVIDE ( [Ventas Totales], CALCULATE ( [Ventas Totales], ALLSELECTED ( DimCliente[Segment] ) ) ),
			    [Ventas Totales]
			)
		displayFolder: Dashboard pt2
		lineageTag: 99f759d1-ffcc-400f-b0df-05647426734a

		formatStringDefinition =
				
				IF (
				    ISINSCOPE ( DimCliente[Segment] ),
				    VAR _txt = "margen " & FORMAT ( [Margen Porcentual], "0.0%" )
				    RETURN CONCATENATEX ( GENERATESERIES ( 1, LEN ( _txt ) ), "\" & MID ( _txt, [Value], 1 ), "", [Value], ASC ),
				    "\$#,0"
				)

	partition Medidas = m
		mode: import
		source =
				let
				    Origen = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Columna1 = _t]),
				    #"Tipo cambiado" = Table.TransformColumnTypes(Origen,{{"Columna1", type text}}),
				    #"Columnas quitadas" = Table.RemoveColumns(#"Tipo cambiado",{"Columna1"})
				in
				    #"Columnas quitadas"

	changedProperty = Name

	annotation PBI_ResultType = Table

