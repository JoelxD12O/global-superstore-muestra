table Medidas
	lineageTag: 8c1864c0-3cc5-4193-a615-feeb0aad86c5

	measure 'Ventas Totales' = SUM ( Base[Sales] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: KPI'S
		lineageTag: f489be68-fb39-410b-bd0f-c4b9a6a8c6ec

	measure 'Ganancia Total' = SUM ( Base[Profit] )
		formatString: \$#,0;-\$#,0;\$#,0
		displayFolder: KPI'S
		lineageTag: dd55abdb-3c01-49cb-a77e-c0df90a98700

	measure 'Margen Porcentual' = DIVIDE ( [Ganancia Total], [Ventas Totales] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI'S
		lineageTag: 771a8019-4742-4936-8019-c29cb92164a3

	measure 'Total Pedidos' = DISTINCTCOUNT ( Base[Order.ID] )
		formatString: #,0
		displayFolder: KPI'S
		lineageTag: c3c2b218-1697-414a-8151-ddf4c4315ecd

	measure '% Lineas con Perdida' =
			
			DIVIDE ( CALCULATE ( COUNTROWS ( Base ), Base[Profit] < 0 ), COUNTROWS ( Base ) )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: KPI'S
		lineageTag: aa5b9622-c18b-45e3-a2ad-ac66584c0661

	/// P4/P13: días promedio entre pedido y envío, por pedido (cada pedido pesa igual sin importar cuántas líneas tenga)
	measure 'Dias Envio Promedio' =
			
			AVERAGEX (
			    VALUES ( Base[Order.ID] ),
			    CALCULATE ( AVERAGEX ( Base, DATEDIFF ( Base[Order.Date], Base[Ship.Date], DAY ) ) )
			)
		formatString: 0.0
		displayFolder: KPI'S
		lineageTag: 78b92a6e-34a6-4148-bd5d-455cd7d66afd

	measure 'Año Referencia' = YEAR ( CALCULATE ( MAX ( Base[Order.Date] ), ALLSELECTED () ) )
		formatString: 0
		displayFolder: KPI'S
		lineageTag: 6cb7fd09-4672-44cb-ab52-60a3f1877c97

	measure 'Var Ventas' =
			
			VAR a = [Año Referencia]
			VAR act = CALCULATE ( [Ventas Totales], Calendario[Año] = a )
			VAR ant = CALCULATE ( [Ventas Totales], Calendario[Año] = a - 1 )
			RETURN DIVIDE ( act - ant, ant )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Variación
		lineageTag: 090ef867-01dc-48d2-a4b8-8dd26dba6122

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var Margen' =
			
			VAR a = [Año Referencia]
			VAR act = CALCULATE ( [Margen Porcentual], Calendario[Año] = a )
			VAR ant = CALCULATE ( [Margen Porcentual], Calendario[Año] = a - 1 )
			RETURN IF ( NOT ISBLANK ( act ) && NOT ISBLANK ( ant ), ( act - ant ) * 100 )
		formatString: +0.0 "pp";-0.0 "pp";0.0 "pp"
		displayFolder: Variación
		lineageTag: 753726fe-dd6f-4f13-9fca-7acd5122aeb5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Var Dias' =
			
			VAR a = [Año Referencia]
			VAR act = CALCULATE ( [Dias Envio Promedio], Calendario[Año] = a )
			VAR ant = CALCULATE ( [Dias Envio Promedio], Calendario[Año] = a - 1 )
			RETURN IF ( NOT ISBLANK ( act ) && NOT ISBLANK ( ant ), act - ant )
		formatString: +0.0;-0.0;0.0
		displayFolder: Variación
		lineageTag: d3b9a5e1-9076-444f-8d71-2968cbec05fd

