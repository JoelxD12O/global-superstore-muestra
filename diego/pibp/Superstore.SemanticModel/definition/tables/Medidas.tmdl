	measure 'Tendencia Dias' =
			
			VAR sel = [Año Referencia]
			VAR y = SELECTEDVALUE ( 'Años Eje'[Año Eje] )
			RETURN IF ( y = sel || y = sel - 1, CALCULATE ( [Dias Envio Promedio], REMOVEFILTERS ( Calendario ), Calendario[Año] = y ) )
