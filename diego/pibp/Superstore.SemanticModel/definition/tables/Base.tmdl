	column 'Rango Descuento' = SWITCH ( Base[Orden Descuento], 1, "Sin descuento", 2, "Bajo (1–20%)", 3, "Medio (21–40%)", "Alto (>40%)" )
		dataType: string
		lineageTag: e328402b-2975-47d1-a18a-16cffe14d113
		sortByColumn: 'Orden Descuento'

	/// Clave Subcategoría · Mercado para la Gráfica 9 (P16)
	column Combinación = RELATED ( DimProducto[Sub.Category] ) & " · " & RELATED ( DimUbicacion[Market] )
		dataType: string
		isHidden
		lineageTag: b42028f0-82ba-4709-bbb0-757a62f1c20f

