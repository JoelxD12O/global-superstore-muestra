		summarizeBy: none
		sortByColumn: 'Orden Envio'

	column 'Orden Descuento' = SWITCH ( TRUE (), Base[Discount] = 0, 1, Base[Discount] <= 0.2, 2, Base[Discount] <= 0.4, 3, 4 )
		dataType: int64
		isHidden
		lineageTag: 3cfec24b-aa86-47a3-b104-46038726d37a
